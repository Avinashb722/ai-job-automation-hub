# ===================================================================
# AI Job Automation Hub — Environment Variables Template
# Copy this file to .env or configure directly via the Web Dashboard (http://localhost:8765)
# ===================================================================

# ── Portal Authentication ───────────────────────────────────────────
# Required for Naukri direct apply and auto-session renewal
NAUKRI_USERNAME=your_naukri_email_or_phone
PASSWORD=your_naukri_password

# ── AI Providers & Scoring Engines ──────────────────────────────────
# Active AI provider: "gemini" or "groq"
AI_PROVIDER=gemini

# Google Gemini (Recommended — 1,500 free requests/day)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq Cloud (Ultra-low latency open-source models)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Candidate Resume ────────────────────────────────────────────────
# Path to your active PDF resume for auto-uploading
RESUME_PATH=C:\Users\Hp\Downloads\resume.pdf
