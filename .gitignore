# ===================================================================
# AI Job Automation Hub — .gitignore
# ===================================================================

# Environment variables & secrets (NEVER commit secrets!)
.env
.env.local
.env.*.local
*.env
session.json

# Local databases and application caches
*.db
*.db-journal
*.sqlite
*.sqlite3

# Python build artifacts & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
venv/
env/
ENV/
.venv/

# Node.js & Monorepo artifacts
node_modules/
.pnpm/
.modules.yaml
.pnpm-workspace-state-v1.json
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.turbo/
.next/
out/
.expo/

# OS-generated files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# IDE & Editor folders
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.agent/
